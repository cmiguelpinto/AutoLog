.login-view {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: linear-gradient(135deg, #10131b, #1b2130);
}

.login-card {
  width: min(380px, 100%);
  background: white;
  border-radius: 28px;
  padding: 24px;
  box-shadow: 0 24px 70px rgba(0,0,0,.25);
}

.login-card h1 {
  font-size: 28px;
  margin-bottom: 6px;
}

.login-card p {
  color: #697087;
  font-weight: 700;
  margin-bottom: 18px;
}

.login-card input {
  width: 100%;
  padding: 14px;
  border-radius: 16px;
  border: 1.5px solid #e3e7ef;
  margin-bottom: 10px;
  font-size: 15px;
}

.login-card button {
  width: 100%;
  padding: 14px;
  border-radius: 16px;
  border: 0;
  background: #10131b;
  color: white;
  font-weight: 900;
  margin-top: 8px;
}

.login-card button.secondary {
  background: #eef1f7;
  color: #10131b;
}
